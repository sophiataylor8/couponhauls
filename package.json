{
  "name": "couponhauls",
  "version": "0.0.1",
  "description": "CouponHauls - Coupon website",
  "scripts": {
    "dev": "bash scripts/dev-server.sh",
    "build": "hugo --minify && bash scripts/copy-static.sh",
    "build:preview": "hugo --minify && bash scripts/copy-static.sh && hugo server --renderToDisk",
    "build:css": "tailwindcss -i ./assets/css/main.css -o ./static/css/style.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0"
  }
}